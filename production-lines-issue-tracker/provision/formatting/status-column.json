{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "style": {
    "display": "inline-flex",
    "align-items": "center",
    "gap": "6px",
    "padding": "2px 8px",
    "border-radius": "3px",
    "font-size": "11px",
    "font-weight": "600",
    "letter-spacing": ".04em",
    "text-transform": "uppercase",
    "background-color": "=if(@currentField == 'Resolved' || @currentField == 'Closed', '#E2F0E9', if(@currentField == 'Waiting on Parts', '#F7EEDC', if(@currentField == 'In Progress', '#E2F0F2', '#EDF0F2')))",
    "color": "=if(@currentField == 'Resolved' || @currentField == 'Closed', '#2E7D5B', if(@currentField == 'Waiting on Parts', '#B57312', if(@currentField == 'In Progress', '#0E6E7D', '#47535E')))"
  },
  "children": [
    {
      "elmType": "span",
      "attributes": {
        "iconName": "=if(@currentField == 'Resolved' || @currentField == 'Closed', 'CheckMark', if(@currentField == 'Waiting on Parts', 'Clock', if(@currentField == 'In Progress', 'Sync', 'CircleAddition')))"
      },
      "style": { "font-size": "12px" }
    },
    { "elmType": "span", "txtContent": "@currentField" }
  ]
}
